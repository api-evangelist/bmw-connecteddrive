            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List the containers"
        },
        {
          "info": {
            "name": "Create a container",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-cardata.bmwgroup.com/customers/containers",
            "headers": [
